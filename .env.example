# 이 파일을 .env 로 복사해서 쓴다. .env 는 커밋하지 않는다.

# true 면 모델을 부르지 않고 계약대로의 더미 응답을 낸다 (app/stubs.py, 제목 표식으로 시나리오 선택).
# false 면 게이트웨이(app/gateway.py)가 HCX 를 부른다.
CC_STUB_MODE=true

# BE 는 인증 헤더를 보내지 않는다 (계약 v0.2). 운영에서는 네트워크 경계로 막는다(#31).
# 굳이 켜려면 BE 의 HttpLlmGateway 에도 헤더를 추가해야 한다.
CC_REQUIRE_INTERNAL_TOKEN=false
# CC_INTERNAL_TOKEN=dev-token

# 프로바이더 — STUB_MODE=false 일 때만 필요하다. 키는 절대 커밋하지 않는다.
# CC_HCX_API_KEY=nv-...
# CC_HCX_MODEL=HCX-DASH-002        # 제일 싼 모델. 품질 근거가 생기면 HCX-005
# CC_LLM_TIMEOUT_S=18              # BE 읽기 타임아웃(20초)보다 낮게

# LLM 리플레이 캐시 (#35) — off | record | replay
# record: 없으면 부르고 녹화. replay: 녹화본만 쓰고 없으면 503 (CI 가 돈을 못 쓰게)
# CC_LLM_CACHE=off
# CC_LLM_CACHE_DIR=.cache/llm
