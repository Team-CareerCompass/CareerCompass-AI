# 이 파일을 .env 로 복사해서 쓴다. .env 는 커밋하지 않는다.

# BE 와 공유하는 내부 호출 토큰 (계약 「공통 규약」)
CC_INTERNAL_TOKEN=dev-token

# true 면 모델을 부르지 않고 계약대로의 더미 응답을 낸다.
# #1 단계에서는 항상 true. 게이트웨이(#2)가 붙으면 false 로 내린다.
CC_STUB_MODE=true

# 프로바이더 키 — STUB_MODE=false 일 때만 필요하다. 절대 커밋하지 않는다.
# CC_AWS_REGION=ap-northeast-2
# CC_HCX_API_KEY=
